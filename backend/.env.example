# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<db_user>:<db_password>@<cluster_address>/<db_name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ucare_hospital?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=ucare_hospital_secret_jwt_key_2026

# Deployed Frontend Client URL (for CORS)
CLIENT_URL=https://ucare-hospital-2u9g.vercel.app

# Environment
NODE_ENV=production
